# ===== PostgreSQL (阿里云) =====
# 格式: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://eth_user:your_password@your.aliyun.ip:5432/eth_analysis
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ===== OKX 行情 =====
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com
# 多币种用逗号分隔，例如：ETH-USDT-SWAP,BTC-USDT-SWAP
SYMBOLS=ETH-USDT-SWAP
EXCHANGES=okx

# ===== OKX REST 网络行为 =====
# 单次 HTTP 请求超时（秒）
OKX_REST_TIMEOUT=10
# 网络异常重试次数（总请求数 = 1 + 重试数）
OKX_REST_MAX_RETRIES=3
# 指数退避基数（秒）：第 n 次重试等待 backoff * 2^n 秒
OKX_REST_RETRY_BACKOFF=0.8
# 是否读取系统代理环境变量（HTTP_PROXY/HTTPS_PROXY 等）
# 默认 false：实测走系统代理时 TLS 握手会偶发失败，直连更稳
OKX_REST_TRUST_ENV=false
# 显式代理（留空表示不使用），例如 http://127.0.0.1:7890
OKX_REST_PROXY=

# ===== DeepSeek (LangChain) =====
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认使用 DeepSeek-V4-Pro，支持思考模式（reasoning_content）
DEEPSEEK_MODEL=deepseek-v4-pro
# 思考模式开关：true=enabled / false=disabled。
# 开启后模型会先输出思维链再给出最终答案，准确率更高，但延迟与 token 更多。
DEEPSEEK_THINKING_ENABLED=true
# 思考强度：high / max（low/medium 会被映射为 high，xhigh 会被映射为 max）
DEEPSEEK_REASONING_EFFORT=high
# temperature 仅在思考模式关闭时生效；思考模式下被服务端忽略。
LLM_TEMPERATURE=0.2
# 单次 LLM 调用超时（秒）。思考模式推理较慢，建议至少 120s。
LLM_TIMEOUT=300
# LLM 调用最小间隔（秒）：同一 symbol 在该窗口内会复用上一次 LLM 结果，
# 避免高频付费调用。默认 900 秒（15 分钟）。设为 0 可关闭节流。
LLM_MIN_INTERVAL_SECONDS=900

# ===== 信号 / 因子参数 =====
SIGNAL_INTERVAL_SECONDS=30
# 因子窗口：默认 30 分钟（1800 秒）。
# 5 分钟（300）窗口在 1 分钟 bar 下永远凑不齐 6 根，会让市场结构因子失效。
FACTOR_WINDOW_SECONDS=1800
ORDERBOOK_DEPTH=5
LIQUIDITY_WALL_MULTIPLIER=3.0
REST_POLL_INTERVAL_SECONDS=60

# ===== 规则引擎阈值（业务可调）=====
# 资金净流入绝对值（USD），超过此值才认为有方向性
RULE_NET_FLOW_USD_THRESHOLD=50000
# 盘口失衡绝对值阈值（[-1, 1] 区间）
RULE_ORDERBOOK_IMBALANCE_THRESHOLD=0.15
# 持仓量变动百分比阈值（0.005 = 0.5%）
RULE_OI_CHANGE_THRESHOLD=0.005
# 资金费率阈值（0.00005 ≈ 0.005%/8h，过此值认为偏离中性）
RULE_FUNDING_RATE_THRESHOLD=0.00005

# ===== 数据保留策略（防止高频行情撑爆磁盘）=====
# trades / orderbook_snapshots：信号引擎只读 factor_window 内的，
# 旧数据纯属占地方。保留 24 小时主要用于短期排障 / 复盘。
RETENTION_TRADES_SECONDS=86400
RETENTION_ORDERBOOK_SECONDS=86400
# signals 有审计价值，默认保留 30 天；设为 0 表示永不清理。
RETENTION_SIGNALS_SECONDS=2592000
# 清理任务执行周期（秒），默认 10 分钟跑一次。设为 0 可关闭后台清理。
RETENTION_RUN_INTERVAL_SECONDS=600

# ===== P1 升级开关（4 个独立灰度开关）=====
# 任一关闭即回退到 P0 行为，便于上线后逐项验证。
# ----------------------------------------------------------------
# 订单簿时序：开启后 runner 会以 10s 节流写入 orderbook_metrics 表，
#             因子层切换到 compute_orderbook_factors_timeseries。
ENABLE_ORDERBOOK_TIMESERIES=true
# 散户/精英多空比：开启后 runner 启动 position-ratios-poller，
#                  derivatives 因子层补 account/top_trader 字段。
ENABLE_POSITION_RATIOS=true
# 市场状态检测：开启后因子矩阵根节点挂 regime 字段。
ENABLE_REGIME=true
# 自适应 LLM 节流：开启后按 ATR 比 + regime + alignment 动态计算 min_interval。
ENABLE_ADAPTIVE_THROTTLE=true

# 自适应 LLM 节流上下限（秒）。固定窗口 LLM_MIN_INTERVAL_SECONDS 仍作兜底。
LLM_MIN_INTERVAL_SECONDS_MIN=900
LLM_MIN_INTERVAL_SECONDS_MAX=1800

# orderbook_metrics 写入节流（秒），与 ORDERBOOK_MIN_INTERVAL_SECONDS 独立。
ORDERBOOK_METRICS_MIN_INTERVAL_SECONDS=10
# orderbook_metrics 因子读取窗口 / 1h 基线长度（秒）
ORDERBOOK_METRICS_WINDOW_SECONDS=900
ORDERBOOK_METRICS_BASELINE_SECONDS=3600

# 持仓比 REST 拉取节奏（秒），OKX rubik 接口本身就是 5m 粒度
POSITION_RATIOS_POLL_INTERVAL_SECONDS=300
POSITION_RATIOS_PERIOD=5m

# funding 7 天分位数回看时长（秒）
FUNDING_PCT_RANK_WINDOW_SECONDS=604800

# regime / 流动性地图阈值
REGIME_ADX_TRENDING_THRESHOLD=25
REGIME_ADX_RANGING_THRESHOLD=18
LIQUIDITY_ROUND_LEVEL_STEP_USD=50
LIQUIDITY_MAX_LEVELS_PER_SIDE=5

# ===== P2 升级开关（3 个独立灰度开关）=====
# 任一关闭即回退到 P1 行为，便于上线后逐项验证。
# ----------------------------------------------------------------
# 因子权重表：开启后规则引擎从 factor_weights 表读权重 + 5 分钟缓存。
ENABLE_FACTOR_WEIGHTS_TABLE=true
# 信号生命周期跟踪：开启后每条信号入库会挂 pending lifecycle，
# 后台跟踪任务每 30 秒扫描"是否 entered / SL / TP / expire"。
ENABLE_LIFECYCLE_TRACKING=true
# LLM 自我反馈：开启后 analyze() 在 prompt 开头注入近 5 条已结算成绩单。
ENABLE_LLM_SELF_FEEDBACK=true

# IC 校准影子模式：true 表示 IC 任务只写表 + 日志，但 RuleEngine
# 不读权重表（仍走 P1 兜底）；上线两周对比后再切到 false。
IC_CALIBRATOR_SHADOW_MODE=true
# IC 校准任务运行周期（秒）。默认 86400 = 每天一次。
IC_CALIBRATOR_INTERVAL_SECONDS=86400
# IC 任务相对 lifespan 启动后的首次执行延迟（秒）
IC_CALIBRATOR_FIRST_DELAY_SECONDS=30
# 30 天总样本下限：低于该值跳过整轮校准
IC_CALIBRATOR_MIN_TOTAL_SAMPLES=30
# 单个 (regime, timeframe) 组合样本下限：低于该值保留基线
IC_CALIBRATOR_MIN_GROUP_SAMPLES=10
# 手动触发 /admin/calibrate-ic 的 token；留空禁用接口
IC_CALIBRATOR_ADMIN_TOKEN=
# IC 校准日志输出目录
IC_CALIBRATOR_LOG_DIR=logs

# 生命周期跟踪任务节奏 / 默认有效期 / mark price 最大年龄
LIFECYCLE_TICK_SECONDS=30
LIFECYCLE_DEFAULT_TTL_HOURS=24
LIFECYCLE_MARK_PRICE_MAX_AGE_SECONDS=60

# LLM 自我反馈：注入近 N 条成绩单
LLM_FEEDBACK_RECENT_N=5

# ===== 邮件通知（Resend HTTP API）=====
# 当 LLM 给出明确方向（做多 / 做空）时向已录入的邮箱发送一封 HTML 提醒；
# 观望 / 缓存命中 都不会发。
# 实现：调用 https://resend.com 的 HTTPS REST API（替代传统 SMTP 端口），
# 国内云主机出口 25/465/587 被封禁时仍可正常发件。
# 主开关：false 时即便 RESEND_API_KEY 已配置也不会发邮件。
ENABLE_EMAIL_NOTIFICATION=true
# Resend API Key（在 https://resend.com/api-keys 申请，re_ 开头）
RESEND_API_KEY=re_replace_me
# 发件人地址，支持两种格式：
#   - "noreply@your-domain.com"                       （仅邮箱）
#   - "ETH 量化交易系统 <noreply@your-domain.com>"     （带显示名）
# 必须使用 Resend 控制台已 DNS 验证过的域名（如本项目使用的 mail.imywh.com），
# 否则 API 会返回 403 invalid_from_address。
# 注意：onboarding@resend.dev 是 Resend 官方测试地址，仅能发到账号注册邮箱本人，
#       不要在生产 / 多收件人场景使用，否则 API 会拒绝并返回 4xx。
RESEND_FROM=ETH 量化交易系统 <noreply@your-domain.com>
# Resend HTTP 调用超时（秒），仅作语义占位（SDK 暂不暴露 timeout 参数）。
RESEND_TIMEOUT=20

# ===== P3 升级：决策层守门员 + 离线评估系统 =====
# 总开关：false 时所有 4 道闸门 + size 覆盖全部跳过，行为退回 P2，
# 便于灰度回滚 / 临时关闭对线上的影响。
ENABLE_DECISION_GATES=false
# 闸 1（ATR 门禁）：15m ATR / last_close 低于该比例则跳过 LLM 直接 neutral。
# 0.0025 = 0.25%。ETH 永续在窄幅震荡时这条规则能干掉绝大多数噪声信号。
DECISION_MIN_ATR_PCT_15M=0.0025
# 闸 3（方向稳定性）：当前方向与最近 1 条相反时，必须满足
# |price_now - price_last| ≥ 该倍数 × ATR(1h) 才允许翻转，否则降级 neutral。
DECISION_DIRECTION_FLIP_MIN_PRICE_MOVE_ATR_1H=0.6
# 闸 2（冷静期）：连续 N 次 sl_hit 触发冷静期，期间强制 neutral。
DECISION_COOLDOWN_CONSECUTIVE_SL_THRESHOLD=2
DECISION_COOLDOWN_MINUTES=60
# size 覆盖：服务端最终 clamp 上限。即便 LLM 给 0.25、conf=0.9 也只下 0.10。
DECISION_MAX_POSITION_SIZE_PCT=0.10
# size 覆盖：凯利激进度（0.5 = 半凯利，业界常用保守值）。
DECISION_KELLY_AGGRESSIVENESS=0.5
# 决策层最低 RR 业务门槛。schema 里 1.5 仍保留作为最后安全网。
DECISION_MIN_RR_RATIO=2.0
# SL 最小距离（× ATR(15m) 与入场价百分比，取较大者）。
DECISION_MIN_SL_DISTANCE_ATR_15M=1.5
DECISION_MIN_SL_DISTANCE_PCT=0.005
# 闸 4（规则 vs LLM 冲突保护）：回溯条数 + 胜率阈值。
DECISION_RULE_LLM_CONFLICT_WINDOW=5
DECISION_RULE_LLM_CONFLICT_WINRATE_THRESHOLD=0.4

# 离线评估系统：后台周期统计 fill_rate / 胜率 / 翻转率 / Sharpe / Brier
# 等指标，写入 signal_evaluation 表，并把 24h 摘要灌回 LLM prompt。
ENABLE_SIGNAL_EVALUATION=true
# 评估任务节奏（秒）：5 分钟一轮足够，不需要每 30 秒重算分钟级聚合。
SIGNAL_EVALUATION_INTERVAL_SECONDS=300
# 评估窗口（逗号分隔的分钟数）。三档默认：1h / 6h / 24h。
SIGNAL_EVALUATION_WINDOWS_MINUTES=60,360,1440

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
