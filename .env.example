# ============================================================
# ETH Trading Analysis Platform · .env.example
# ------------------------------------------------------------
# LLM-First 架构：所有"规则反向 → 否决 LLM"、IC 校准、信号生命周期、
# 离线评估、决策闸门均已退场。只保留：
#   1) 基础设施配置（DB / OKX / DeepSeek / 邮件）
#   2) 因子/采集参数（多周期 K 线、爆仓、订单簿时序、持仓比、流动性地图）
#   3) 数据保留策略
#   4) 唯一的服务端"干预"——ATR 极端风控底线
# ============================================================

# ===== PostgreSQL =====
# 格式: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://eth_user:your_password@your.aliyun.ip:5432/eth_analysis
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ===== OKX 行情 =====
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com
# 多币种用逗号分隔，例如：ETH-USDT-SWAP,BTC-USDT-SWAP
SYMBOLS=ETH-USDT-SWAP
EXCHANGES=okx

# ===== OKX REST 网络行为 =====
OKX_REST_TIMEOUT=10
OKX_REST_MAX_RETRIES=3
OKX_REST_RETRY_BACKOFF=0.8
# 是否读取系统代理环境变量（HTTP_PROXY/HTTPS_PROXY 等）。
# 默认 false：实测走系统代理时 TLS 握手会偶发失败，直连更稳。
OKX_REST_TRUST_ENV=false
# 显式代理（留空表示不使用），例如 http://127.0.0.1:7890
OKX_REST_PROXY=

# ===== DeepSeek (LangChain) =====
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认使用 DeepSeek-V4-Pro，支持思考模式（reasoning_content）
DEEPSEEK_MODEL=deepseek-v4-pro
# 思考模式开关：true=enabled / false=disabled
DEEPSEEK_THINKING_ENABLED=true
# 思考强度：high / max
DEEPSEEK_REASONING_EFFORT=high
# temperature 仅在思考模式关闭时生效；思考模式下被服务端忽略
LLM_TEMPERATURE=0.2
# 单次 LLM 调用超时（秒）。思考模式推理较慢，建议至少 120s。
LLM_TIMEOUT=300
# LLM 调用最小间隔（秒）：同一 symbol 在该窗口内复用上一次 LLM 结果，
# 避免高频付费调用。默认 900 秒（15 分钟）。设为 0 可关闭节流。
LLM_MIN_INTERVAL_SECONDS=900

# ===== 信号 / 因子参数 =====
SIGNAL_INTERVAL_SECONDS=30
# 因子窗口：默认 30 分钟（1800 秒）
FACTOR_WINDOW_SECONDS=1800
ORDERBOOK_DEPTH=5
LIQUIDITY_WALL_MULTIPLIER=3.0
REST_POLL_INTERVAL_SECONDS=60

# ATR 极端风控底线：15m ATR / last_close 低于该比例则跳过 LLM 直接 neutral。
# 0.0025 = 0.25%。这是 LLM-First 架构下**唯一**保留的服务端干预，
# 设为 0 / 负数可完全关闭（不推荐）。
DECISION_MIN_ATR_PCT_15M=0.0025

# 风险预算占比（用于 LLM 计算 position_size_pct 的提示）
ACCOUNT_RISK_BUDGET_PCT=0.01

# 多周期 K 线增量任务每个周期的轮询节奏（秒）
KLINE_TICK_SECONDS_1M=1
KLINE_TICK_SECONDS_5M=1
KLINE_TICK_SECONDS_15M=10
KLINE_TICK_SECONDS_1H=10
KLINE_TICK_SECONDS_4H=60
KLINE_TICK_SECONDS_1D=60
# market_structure 每个周期回看的 K 线根数（HH/HL pivot + ATR）
MTF_LOOKBACK_BARS=80
MTF_VOLUME_ZSCORE_WINDOW=30
MTF_DIVERGENCE_LOOKBACK=20
# 爆仓滚动窗口分钟数（cascade_signal 用）
LIQUIDATION_WINDOWS_MINUTES=5,15,60
# cascade_signal 阈值：当前 1m 爆仓 size > 过去 1h 均值 × N 视为级联
LIQUIDATION_CASCADE_MULTIPLIER=5

# 订单簿写入节流（秒）
ORDERBOOK_MIN_INTERVAL_SECONDS=5
ORDERBOOK_METRICS_MIN_INTERVAL_SECONDS=10
ORDERBOOK_METRICS_WINDOW_SECONDS=900
ORDERBOOK_METRICS_BASELINE_SECONDS=3600

# 持仓比 REST 拉取节奏
POSITION_RATIOS_POLL_INTERVAL_SECONDS=300
POSITION_RATIOS_PERIOD=5m
POSITION_RATIOS_MAX_CONSECUTIVE_ERRORS=5

# funding 7 天分位数回看时长（秒）
FUNDING_PCT_RANK_WINDOW_SECONDS=604800

# regime / 流动性地图阈值
REGIME_ADX_TRENDING_THRESHOLD=25
REGIME_ADX_RANGING_THRESHOLD=18
LIQUIDITY_ROUND_LEVEL_STEP_USD=50
LIQUIDITY_MAX_LEVELS_PER_SIDE=5
DEFAULT_CONTRACT_VALUE=0.1

# ===== 数据保留策略 =====
# trades / orderbook_snapshots：信号引擎只读 factor_window 内的，保留 24h 用于排障
RETENTION_TRADES_SECONDS=86400
RETENTION_ORDERBOOK_SECONDS=86400
# signals 有审计价值，默认保留 30 天；设为 0 表示永不清理
RETENTION_SIGNALS_SECONDS=2592000
# 清理任务执行周期（秒），默认 10 分钟跑一次。设为 0 可关闭后台清理。
RETENTION_RUN_INTERVAL_SECONDS=600

# ===== 邮件通知（Resend HTTP API）=====
# 当 LLM 给出明确方向（做多 / 做空）时向已录入的邮箱发送一封 HTML 提醒；
# 观望 / 缓存命中都不会发。false 时即便 RESEND_API_KEY 已配置也不会发邮件。
ENABLE_EMAIL_NOTIFICATION=true
# Resend API Key（在 https://resend.com/api-keys 申请，re_ 开头）
RESEND_API_KEY=re_replace_me
# 发件人地址，必须使用 Resend 控制台已 DNS 验证过的域名
# 支持两种格式："noreply@your-domain.com" 或 "ETH 量化交易系统 <noreply@your-domain.com>"
RESEND_FROM=ETH 量化交易系统 <noreply@your-domain.com>
RESEND_TIMEOUT=20

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
